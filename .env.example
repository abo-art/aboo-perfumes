# Aboo Perfume Sommelier Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Provider: 'auto', 'openai', 'anthropic', 'gemini', or 'mock'
# If keys are omitted, the service runs out-of-the-box with intelligent Sommelier AI simulation.
LLM_PROVIDER=auto

# OpenAI configuration (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude configuration (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# External Perfume Catalog API (e.g. Scento API) (optional)
SCENTO_API_KEY=
SCENTO_API_URL=https://api.scento.app/v1

# Validation Settings
VALIDATION_THRESHOLD=72.0
ENFORCE_CATALOG_VALIDATION=true
